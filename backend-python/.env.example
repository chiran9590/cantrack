# --- Database (PostgreSQL) ------------------------------------------------------------
# Cloud (recommended, free): paste the connection string from neon.com  (Connect button -> copy)
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local Postgres (a role YOU create, see README: never the superuser):
DATABASE_URL=postgresql://cantrack:choose-a-password@localhost:5432/cantrack

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Website address(es) allowed to call the API, comma-separated, no trailing slash
CORS_ORIGIN=http://localhost:5173
# Optional: also allow Vercel preview URLs, e.g.  https://cantrack-.*\.vercel\.app
CORS_ORIGIN_REGEX=
SEED_ADMIN_PASSWORD=ChangeMe123!

# PhenomeOne (server-side only; never put these in the website or app). Leave empty until IT approves the method.
PHENOMEONE_BASE_URL=
PHENOMEONE_USER=
PHENOMEONE_PASSWORD=

# Sign-up. Verification is off: anyone can register. New accounts start with this role (member = read-only).
OPEN_REGISTRATION=true
REGISTRATION_ROLE=member
