# --- Database (MySQL) -----------------------------------------------------------------
# Cloud (Aiven): paste the Service URI from the Aiven dashboard. Keep the ?ssl-mode=REQUIRED at the end.
#   DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Local MySQL (a user YOU create, never root):
DATABASE_URL=mysql://cantrack:choose-a-password@localhost:3306/cantrack

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Website address(es) allowed to call the API, comma-separated, no trailing slash
CORS_ORIGIN=http://localhost:5173
# Optional: also allow Vercel preview URLs, e.g.  https://cantrack-.*\.vercel\.app
CORS_ORIGIN_REGEX=
SEED_ADMIN_PASSWORD=ChangeMe123!

# PhenomeOne (server-side only; never put these in the website or app). Leave empty until IT approves the method.
PHENOMEONE_BASE_URL=
PHENOMEONE_USER=
PHENOMEONE_PASSWORD=

# Sign-up. Verification is off: anyone can register. New accounts start with this role (member = read-only).
OPEN_REGISTRATION=true
REGISTRATION_ROLE=member
